  "glossary": {
   "CrUX": {
    "ja": "Chrome が実際の利用者から集めている表示速度のデータ。Google が公開していて、直近28日ぶんの値が出る。実際に使われた速度なので、検索順位の評価にも使われる。",
    "en": "Real-world speed data Chrome collects from actual visitors, published by Google as a rolling 28-day figure. Because it reflects real use, Google also factors it into search ranking."
   },
   "PageSpeed Insights": {
    "ja": "Google のページ速度測定ツール。その場で1回読み込んで0〜100点で採点する。毎日どのURLでも測れるかわりに、測るたびに振れる。",
    "en": "Google's page speed tool. It loads the page once and scores it 0-100. Any URL can be measured daily, but the score swings between runs."
   },
   "PSI": {
    "ja": "PageSpeed Insights の略。Google のページ速度測定ツールで、その場で1回読み込んで0〜100点で採点する。",
    "en": "Short for PageSpeed Insights, Google's page speed tool that loads the page once and scores it 0-100."
   },
   "p75": {
    "ja": "速い順に並べて、ちょうど75%目にあたる値。4人に3人はこれより速い、という見方をする。平均より実感に近い。",
    "en": "The value at the 75th percentile when sorted fastest first — three in four visitors were faster than this. Closer to lived experience than an average."
   },
   "ラボ値": {
    "ja": "決まった条件（回線・端末）で測った値。条件を揃えられるので比べやすいが、実際の利用者の環境とは違う。",
    "en": "A figure measured under fixed conditions (network, device). Easy to compare run to run, but not what real visitors experience."
   },
   "実ユーザー値": {
    "ja": "実際にページを見た人の端末から集めた値。本当の体感に近いが、訪問が少ないページでは値が出ない。",
    "en": "Figures gathered from the devices of people who actually visited. Closest to real experience, but pages with few visits return nothing."
   },
   "掲載閾値": {
    "ja": "CrUX が値を返すのに必要な訪問数のライン。これを下回るページは、測ろうとしても空で返ってくる。",
    "en": "The visit count CrUX needs before it will return a figure. Below it, a page comes back empty however often you ask."
   },
   "TBT": {
    "ja": "Total Blocking Time。読み込み中に JavaScript の実行でブラウザが固まっていた合計時間。長いほど、押しても反応しない時間が長い。",
    "en": "Total Blocking Time — how long JavaScript kept the browser busy during load. The longer it is, the longer taps go unanswered."
   },
   "28日ローリング": {
    "ja": "その日から遡って28日ぶんをまとめた値。隣り合う日の値は27日ぶん同じデータを共有しているので、1日や1週の増減だけを見ても意味がない。",
    "en": "A figure covering the 28 days up to that date. Neighbouring points share 27 days of data, so a single day's or week's move means little on its own."
   }
  },
